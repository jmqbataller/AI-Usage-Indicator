<Window x:Class="UsageIndicator.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430" Height="64" WindowStyle="None" ResizeMode="NoResize" Background="#FF171A20" Topmost="True" ShowInTaskbar="True">
  <Border x:Name="MainCard" Background="{StaticResource Card}" BorderBrush="#FF363D49" BorderThickness="1" CornerRadius="14" Padding="14" MouseLeftButtonDown="Card_MouseLeftButtonDown" MouseLeftButtonUp="Card_MouseLeftButtonUp" MouseMove="Card_MouseMove">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><TextBlock Text="✦" Foreground="{StaticResource Accent}" FontSize="20" VerticalAlignment="Center"/><TextBlock Text=" AI Work Usage" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/><TextBlock x:Name="CompactStatus" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="9,1,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="AddAccountButton" Content="+ Account" Click="AddAccount_Click" Visibility="Collapsed"/><Button Content="×" FontSize="19" Padding="9,1" Click="Close_Click"/></StackPanel>
      </Grid>
      <Grid x:Name="ExpandedPanel" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Active account:" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox x:Name="AccountPicker" Width="170" Margin="8,0,0,0" SelectionChanged="AccountPicker_SelectionChanged"/></StackPanel>
          <Button Grid.Column="1" Content="Sign in again" Click="SignInAgain_Click"/>
        </Grid>
        <Border Grid.Row="1" Background="#FF202632" CornerRadius="10" Padding="13" Margin="0,14,0,9">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="WORK · SHARED PLAN" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="WorkLabel" Foreground="{StaticResource Text}" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="UsageInfoLabel" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="NEXT RESET" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock x:Name="WorkResetLabel" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"/></StackPanel>
          </Grid>
        </Border>
        <StackPanel Grid.Row="2"><TextBlock x:Name="SyncStatus" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/><TextBlock x:Name="TokenStatus" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,8"/></StackPanel>
        <Border x:Name="LoginPanel" Grid.Row="3" Background="#FF0D0F13" CornerRadius="9" Padding="1" MinHeight="355"><Grid x:Name="BrowserHost" Background="#FFFFFFFF" ClipToBounds="True"/></Border>
      </Grid>
    </Grid>
  </Border>
</Window>
