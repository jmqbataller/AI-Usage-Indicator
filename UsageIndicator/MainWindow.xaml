<Window x:Class="UsageIndicator.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" Height="64" WindowStyle="None" ResizeMode="NoResize" Background="#FF171A20" Topmost="True" ShowInTaskbar="True">
  <Border x:Name="MainCard" Background="{StaticResource Card}" BorderBrush="#FF363D49" BorderThickness="1" CornerRadius="14" Padding="14" MouseLeftButtonDown="Card_MouseLeftButtonDown" MouseLeftButtonUp="Card_MouseLeftButtonUp" MouseMove="Card_MouseMove">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><TextBlock Text="✦" Foreground="{StaticResource Accent}" FontSize="20" VerticalAlignment="Center"/><TextBlock Text=" AI Usage" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/><TextBlock x:Name="CompactStatus" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="9,1,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="AddAccountButton" Content="+ Account" Click="AddAccount_Click" Visibility="Collapsed"/><Button Content="×" FontSize="19" Padding="9,1" Click="Close_Click"/></StackPanel>
      </Grid>
      <Grid x:Name="ExpandedPanel" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Active account:" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox x:Name="AccountPicker" Width="155" Margin="8,0,0,0" SelectionChanged="AccountPicker_SelectionChanged"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Open ChatGPT" Click="OpenChatGpt_Click"/><Button Content="Refresh" Click="Refresh_Click"/></StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,14,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Background="#FF202632" CornerRadius="9" Padding="11" Margin="0,0,5,0"><StackPanel><TextBlock Text="CHAT" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="ChatLabel" Foreground="{StaticResource Text}" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="ChatResetLabel" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
          <Border Grid.Column="1" Background="#FF202632" CornerRadius="9" Padding="11" Margin="5,0,0,0"><StackPanel><TextBlock Text="WORK" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="WorkLabel" Foreground="{StaticResource Text}" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="WorkResetLabel" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
        </Grid>
        <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock x:Name="SyncStatus" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,7"/>
          <Grid x:Name="BrowserHost" Grid.Row="1" Background="#FFFFFFFF" ClipToBounds="True"/>
          <TextBlock x:Name="TokenStatus" Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,7,0,0"/>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
